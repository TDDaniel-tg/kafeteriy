# Общие параметры окружения системы «Кафетерий льгот»
DEBUG=1
SECRET_KEY=cafeteria-secret-key-change-in-production-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# База данных PostgreSQL
POSTGRES_DB=cafeteria_db
POSTGRES_USER=cafeteria_user
POSTGRES_PASSWORD=cafeteria_secret
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cafeteria_user:cafeteria_secret@db:5432/cafeteria_db

# Redis и Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Локализация и часовой пояс
TIME_ZONE=Europe/Moscow
LANGUAGE_CODE=ru-ru

# Интеграции (1 = Mock режим, 0 = Real)
MOCK_INTEGRATIONS=1

# 1С:ЗУП
ZUP_1C_API_URL=https://1c-zup.company.local/odata/standard.odata
ZUP_1C_USERNAME=sync_user
ZUP_1C_PASSWORD=sync_secret

# SSO (OIDC / SAML)
SSO_PROVIDER=mock
SSO_CLIENT_ID=cafeteria-client
SSO_CLIENT_SECRET=cafeteria-sso-secret
SSO_DISCOVERY_URL=https://sso.company.local/.well-known/openid-configuration

# SMTP
EMAIL_HOST=smtp.company.local
EMAIL_PORT=587
EMAIL_HOST_USER=noreply-cafeteria@company.ru
EMAIL_HOST_PASSWORD=smtp_secret
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=«Кафетерий льгот» <noreply-cafeteria@company.ru>

# Giftery / Prostodar
GIFTERY_API_URL=https://api.giftery.ru/v1
GIFTERY_API_KEY=mock-giftery-api-key
PROSTODAR_API_URL=https://api.prostodar.ru/v2
PROSTODAR_CLIENT_ID=mock-prostodar-client
PROSTODAR_SECRET=mock-prostodar-secret

# Фронтенд
VITE_API_URL=/api
PORT=3000
